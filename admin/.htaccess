# ── Admin panel — seguridad ──────────────────────────────────
Options -Indexes

# ── Subida de archivos ────────────────────────────────────────
php_value upload_max_filesize 200M
php_value post_max_size       210M
php_value max_execution_time  300
php_value max_input_time      300

# ── Forzar HTTPS ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\. [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Impedir indexación por buscadores
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

  # Prevenir clickjacking (el admin no debe cargarse en iframes)
  Header always set X-Frame-Options "DENY"

  # Prevenir que el navegador adivine el tipo MIME
  Header always set X-Content-Type-Options "nosniff"

  # No enviar Referer a sitios externos
  Header always set Referrer-Policy "same-origin"

  # Deshabilitar características del navegador que no se usan
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# Bloquear acceso directo a archivos sensibles del admin
<FilesMatch "\.(log|env|bak|sql|sh|conf|json\.dist)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Bloquear scanners y bots comunes por User-Agent
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|hydra|burpsuite|zgrab|dirbuster|gobuster|wfuzz|nuclei) [NC]
  RewriteRule .* - [F,L]
</IfModule>

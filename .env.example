# Variables de entorno requeridas por el proyecto.
# En Hostinger (hPanel, plan Premium): no hay UI de "Environment Variables",
# así que se definen via SetEnv directamente en el .htaccess del servidor
# (NO en el .htaccess de este repo — ese solo tiene reglas de seguridad,
# nunca secretos). El .htaccess real vive solo en el servidor.
# En local: define las mismas variables en tu entorno (nunca las hardcodees en el código).

# ── Base de datos (includes/conexion.php) ─────────────────────
# DB_HOST en Hostinger NO es localhost — es un servidor MySQL remoto propio
# (requiere activar "MySQL remoto" en hPanel con acceso %).
DB_HOST=localhost
DB_NAME=dematiq_db
DB_USER=dematiq_app
DB_PASS=

# ── SMTP para el formulario de contacto y recuperación de contraseña ──
# (api/contacto.php, pages/corporativo/forgot-password.php)
# El puerto 465 con SMTP_SECURE=smtps se cuelga indefinidamente en este
# hosting (nunca responde, termina en 504/307). Usar 587 con STARTTLS.
# SMTP_PASS es una "contraseña de aplicación" de Gmail (Cuenta de Google →
# Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones),
# NO la contraseña normal de la cuenta dematiq3@gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_USER=dematiq3@gmail.com
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_TO=ventas@dematiq.com.mx
